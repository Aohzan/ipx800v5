#!/usr/bin/env bash
# Set up the development environment: dependencies, git hooks and the Home
# Assistant configuration in config/.

set -e

cd "$(dirname "$0")/.."

uv sync
uv run prek install

# config/ is not tracked: create the development configuration only once, an
# existing one may hold the settings of a real IPX800
if [[ ! -f config/configuration.yaml ]]; then
  mkdir -p config
  cat > config/configuration.yaml <<'YAML'
# Home Assistant configuration for development, see scripts/develop
default_config:

logger:
  default: info
  logs:
    custom_components.ipx800v5: debug
    pypx800v5: debug
YAML
fi
uv run hass --script ensure_config -c config
